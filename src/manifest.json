{
  "manifest_version": 3,
  "name": "NavGPT - Chat Navigator",
  "version": "1.6.0",
  "description": "Fast navigation for ChatGPT and Grok conversations, plus custom Grok actions on X posts.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://x.com/*",
    "https://twitter.com/*",
    "https://grok.com/*"
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_title": "Toggle NavGPT",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "background": {
    "service_worker": "background/index.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["content/index.ts"]
    },
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["content/x/index.ts"]
    },
    {
      "matches": ["https://grok.com/*"],
      "js": ["content/grok/index.ts"],
      "run_at": "document_idle"
    }
  ]
}
