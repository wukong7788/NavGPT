{
  "manifest_version": 3,
  "name": "NavGPT - Chat Navigator",
  "version": "1.1.1",
  "description": "Fast navigation for ChatGPT conversations.",
  "permissions": ["storage"],
  "host_permissions": ["https://chatgpt.com/*"],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_title": "Toggle NavGPT",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "background": {
    "service_worker": "background/index.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["content/index.ts"]
    }
  ]
}
